{
  "packageName": "dev.skystream.aniworld",
  "name": "AniWorld",
  "version": 3,
  "baseUrl": "https://aniworld.to",
  "description": "AniWorld.to — German dub and German/English sub anime with VOE, Vidmoly, Filemoon and Doodstream sources.",
  "authors": ["Buffy"],
  "languages": ["de", "en"],
  "categories": ["Anime"],
  "settings": [
    {
      "key": "language",
      "title": "Preferred language",
      "description": "Filter the source list to one language. Falls back to all languages when the episode has no source in it.",
      "type": "select",
      "defaultValue": "auto",
      "options": [
        { "label": "Auto (all languages)", "value": "auto" },
        { "label": "German Dub", "value": "1" },
        { "label": "English Sub", "value": "2" },
        { "label": "German Sub", "value": "3" }
      ]
    }
  ],
  "domains": [
    { "name": "aniworld.to", "url": "https://aniworld.to" },
    { "name": "aniworld.cc", "url": "https://aniworld.cc" },
    { "name": "aniworld.cx", "url": "https://aniworld.cx" },
    { "name": "aniworld.io", "url": "https://aniworld.io" }
  ]
}
